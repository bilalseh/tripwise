# Copy to api/.env for local development. Never commit real values.
ENVIRONMENT=local
APP_VERSION=dev
APP_URL=http://localhost:5173
# `demo-` project IDs work offline with the Firebase emulators.
FIREBASE_PROJECT_ID=demo-tripwise
LOG_LEVEL=INFO
# Point the API at the local emulators started with `pnpm emulators`.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# AI: "fake" needs no key; "gemini,groq" tries Gemini first and falls back to Groq.
AI_PROVIDERS=fake
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Places, routing and weather: "fake" works offline; "osm" calls Photon, Nominatim, the OSRM
# demo server and Open-Meteo (respecting their usage policies).
PLACES_PROVIDER=fake

# Billing: Stripe TEST MODE keys only (sk_test_...); live keys are refused.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
