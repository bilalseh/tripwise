# Production values are GitHub repository variables, injected at build time
# (.github/workflows/deploy.yml). Firebase web config is public; it identifies the project.
# For local development, web/.env.development already points at the emulators.
VITE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
