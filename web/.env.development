# Local development and E2E tests run against the Firebase emulators (`pnpm emulators`).
# These are placeholder values for the offline `demo-tripwise` project, not real credentials.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tripwise.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-tripwise
VITE_FIREBASE_APP_ID=demo-app-id
