rules_version = '2';

// Users may read only their own data. Every write goes through the API, which validates it
// with Pydantic and uses the Admin SDK (not subject to these rules). Share links, billing
// records, global AI usage and the response cache are server-only. See docs/adr/0005.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
